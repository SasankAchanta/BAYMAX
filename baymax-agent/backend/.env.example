CAMERA_INDEX=0
ENABLE_REAL_ALERTS=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
DEMO_EMERGENCY_PHONE=
CHECK_IN_SECONDS=15
