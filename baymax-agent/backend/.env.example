NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/llama-3.1-nemotron-70b-instruct
NVIDIA_VISION_MODEL=
ENABLE_CAMERA=false
# When camera, key, and vision model are configured, send a frame every 6s.
ENABLE_PROACTIVE_VISION=true
CAMERA_INDEX=0
ENABLE_REAL_ALERTS=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
DEMO_EMERGENCY_PHONE=
CHECK_IN_SECONDS=15

ENABLE_CHATTERBOX=true
# Optional absolute WAV path; defaults to backend/baymax_ref.wav
TTS_REFERENCE_PATH=
# Optional Hugging Face token for restricted model access
HF_TOKEN=

# Private local SpacetimeDB; token stays on the server.
SPACETIMEDB_URL=http://127.0.0.1:3000
SPACETIMEDB_DATABASE=baymax-care
SPACETIMEDB_TOKEN=
# Optional live Amazon product prices/links through Rainforest API.
RAINFOREST_API_KEY=

TWILIO_ALERT_MODE=sms
# Trial only: sms_internal_alerts sends fixed Twilio content, not custom BAYMAX details.
TWILIO_SMS_TEMPLATE=
